pipeline {
    agent none

    options {
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 30, unit: 'MINUTES')
    }

    parameters {
        string(
            name: 'APP_REPO',
            defaultValue: 'https://github.com/rohitg00/agentmemory.git',
            description: 'Git URL of the agentmemory application repo'
        )
        string(
            name: 'APP_BRANCH',
            defaultValue: 'main',
            description: 'Branch of the application repo to build'
        )
        string(
            name: 'DOCKERFILE',
            defaultValue: 'deploy/Dockerfile',
            description: 'Dockerfile path inside the application repo'
        )
        booleanParam(
            name: 'FORCE_REBUILD',
            defaultValue: false,
            description: 'Build and push even if the image tag already exists in Harbor'
        )
    }

    environment {
        APP_REPO      = "${params.APP_REPO}"
        APP_BRANCH    = "${params.APP_BRANCH}"
        DOCKERFILE    = "${params.DOCKERFILE}"
        FORCE_REBUILD = "${params.FORCE_REBUILD}"

        REGISTRY_HOST = 'harbor.dreadwrym.my.id'
        IMAGE_REPO    = 'harbor.dreadwrym.my.id/apps/agentmemory'
        CACHE_REPO    = 'harbor.dreadwrym.my.id/apps/agentmemory-cache'
        AUTHFILE      = '/auth/.dockerconfigjson'

        PUBLIC_HOSTNAME = 'agentmemory.dreadwrym.my.id'
    }

    stages {
        stage('Build & Push') {
            agent { label 'buildah' }

            stages {
                stage('Checkout') {
                    steps {
                        dir('app') {
                            git url: env.APP_REPO, branch: env.APP_BRANCH, changelog: false, poll: false
                        }

                        script {
                            def appSha = sh(script: 'git -C app rev-parse --short=12 HEAD', returnStdout: true).trim()
                            env.IMAGE = "${env.IMAGE_REPO}:${appSha}"
                        }
                    }
                }

                stage('Check Harbor') {
                    steps {
                        container('buildah') {
                            script {
                                def status = sh(script: '''
                                    set +e
                                    buildah --storage-driver=vfs pull \
                                        --quiet \
                                        --authfile "$AUTHFILE" \
                                        "docker://$IMAGE" >/tmp/pull.log 2>&1
                                    rc=$?
                                    if [ "$rc" -ne 0 ]; then tail -n 5 /tmp/pull.log; fi
                                    exit "$rc"
                                ''', returnStatus: true)

                                env.IMAGE_EXISTS = (status == 0).toString()
                                if (status == 0) {
                                    echo "Image already in Harbor: ${env.IMAGE}"
                                } else {
                                    echo "Image missing from Harbor: ${env.IMAGE}"
                                }
                            }
                        }
                    }
                }

                stage('Build Image') {
                    when {
                        expression { env.IMAGE_EXISTS != 'true' || env.FORCE_REBUILD == 'true' }
                    }
                    steps {
                        container('buildah') {
                            sh '''
                                set -eu

                                REGCONF="$(mktemp)"
                                printf 'unqualified-search-registries = ["docker.io"]\\n' > "$REGCONF"
                                export CONTAINERS_REGISTRIES_CONF="$REGCONF" 

                                CONTEXT="app/$(dirname "$(dirname "$DOCKERFILE")")" 

                                buildah build \
                                    --storage-driver=vfs \
                                    --isolation=chroot \
                                    --layers \
                                    --cache-from "$CACHE_REPO" \
                                    --cache-to "$CACHE_REPO" \
                                    --authfile "$AUTHFILE" \
                                    --file "app/$DOCKERFILE" \
                                    --tag "$IMAGE" \
                                    "$CONTEXT"
                            '''
                        }
                    }
                }

                stage('Push Image') {
                    when {
                        expression { env.IMAGE_EXISTS != 'true' || env.FORCE_REBUILD == 'true' }
                    }
                    steps {
                        container('buildah') {
                            sh '''
                                set -eu

                                buildah --storage-driver=vfs push \
                                    --authfile "$AUTHFILE" \
                                    "$IMAGE" "docker://$IMAGE"
                            '''
                        }
                    }
                }
            }
        }

        stage('Deploy') {
            agent { label 'terraform' }

            stages {
                stage('Checkout') {
                    steps {
                        checkout scm
                    }
                }

                stage('Terraform Init') {
                    steps {
                        container('terraform') {
                            dir('apps/agentmemory') {
                                sh 'terraform init -input=false -lock-timeout=60s -backend-config="in_cluster_config=true"'
                            }
                        }
                    }
                }

                stage('Terraform Plan') {
                    steps {
                        container('terraform') {
                            dir('apps/agentmemory') {
                                sh 'terraform plan -input=false -lock-timeout=60s -out=tfplan -var="image=${IMAGE}" -var="hostname=${PUBLIC_HOSTNAME}"'
                            }
                        }
                    }
                }

                stage('Terraform Apply') {
                    steps {
                        container('terraform') {
                            dir('apps/agentmemory') {
                                sh 'terraform apply -input=false -lock-timeout=60s -auto-approve tfplan'
                            }
                        }
                    }
                }
            }
        }
    }
}
