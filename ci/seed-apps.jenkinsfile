// Triggered by SCM polling (configured in infra/jenkins/values.yaml).
pipeline {
    agent { label 'buildah' }

    options {
        disableConcurrentBuilds()
    }

    stages {
        stage('Create app jobs') {
            steps {
                checkout scm

                script {
                    def repoUrl = env.GIT_URL ?: 'https://github.com/Richie-Z/homelab.git'
                    def branchName = (env.GIT_BRANCH ?: 'origin/master').replaceFirst('origin/', '')

                    def apps = sh(
                            script: 'ls apps/*/Jenkinsfile 2>/dev/null || true',
                            returnStdout: true
                        ).trim()
                        .readLines()
                        .findAll { it }
                        .collect { it.split('/')[1] }
                        .unique()
                        .sort()

                    def thirdParty = sh(
                            script: 'ls thirdparty/*/Jenkinsfile 2>/dev/null || true',
                            returnStdout: true
                        ).trim()
                        .readLines()
                        .findAll { it }
                        .collect { it.split('/')[1] }
                        .unique()
                        .sort()

                    def dsl = ''

                    if (!apps) {
                        echo 'No apps/*/Jenkinsfile found'
                    } else {
                        dsl = "folder('apps')\n" + apps.collect { app ->
                            """
                            pipelineJob('apps/${app}') {
                              description('Generated from apps/${app}/Jenkinsfile')
                              definition {
                                cpsScm {
                                  scm {
                                    git {
                                      remote { url('${repoUrl}') }
                                      branch('*/${branchName}')
                                    }
                                  }
                                  scriptPath('apps/${app}/Jenkinsfile')
                                }
                              }
                            }
                            """
                        }.join('\n')
                        echo "Seeded jobs: ${apps.join(', ')}"
                    }

                    if (thirdParty) {
                        dsl += "\nfolder('thirdparty')\n" + thirdParty.collect { name ->
                            """
                            pipelineJob('thirdParty/${name}') {
                              description('Generated from thirdparty/${name}/Jenkinsfile')
                              definition {
                                cpsScm {
                                  scm {
                                    git {
                                      remote { url('${repoUrl}') }
                                      branch('*/${branchName}')
                                    }
                                  }
                                  scriptPath('thirdparty/${name}/Jenkinsfile')
                                }
                              }
                            }
                            """
                        }.join('\n')
                        echo "Seeded thirdParty jobs: ${thirdParty.join(', ')}"
                    }

                    writeFile file: 'generated_jobs.groovy', text: dsl
                    jobDsl targets: 'generated_jobs.groovy', removedJobAction: 'IGNORE'
                }
            }
        }
    }
}
