pipeline {
    agent none

    options {
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 30, unit: 'MINUTES')
    }

    parameters {
        string(
            name: 'IMAGE_TAG',
            defaultValue: 'diegosouzapw/omniroute:latest',
            description: 'OmniRoute image to deploy'
        )
    }

    environment {
        IMAGE           = "${params.IMAGE_TAG}"
        PUBLIC_HOSTNAME = 'omniroute.dreadwrym.my.id'
    }

    stages {
        stage('Deploy') {
            agent { label 'terraform' }

            stages {
                stage('Checkout') {
                    steps {
                        checkout scm
                    }
                }

                stage('Terraform Init') {
                    steps {
                        container('terraform') {
                            dir('apps/omniroute') {
                                sh 'terraform init -input=false -lock-timeout=60s -backend-config="in_cluster_config=true"'
                            }
                        }
                    }
                }

                stage('Terraform Plan') {
                    steps {
                        container('terraform') {
                            dir('apps/omniroute') {
                                sh 'terraform plan -input=false -lock-timeout=60s -out=tfplan -var="image=${IMAGE}" -var="hostname=${PUBLIC_HOSTNAME}"'
                            }
                        }
                    }
                }

                stage('Terraform Apply') {
                    steps {
                        container('terraform') {
                            dir('apps/omniroute') {
                                sh 'terraform apply -input=false -lock-timeout=60s -auto-approve tfplan'
                            }
                        }
                    }
                }
            }
        }
    }
}
