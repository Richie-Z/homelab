pipeline {
    agent none

    options {
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 30, unit: 'MINUTES')
    }

    parameters {
        string(
            name: 'APP_REPO',
            defaultValue: 'https://github.com/rohitg00/agentmemory.git',
            description: 'Git URL of the agentmemory application repo'
        )
        string(
            name: 'APP_BRANCH',
            defaultValue: 'main',
            description: 'Branch of the application repo to build'
        )
        string(
            name: 'DOCKERFILE',
            defaultValue: 'deploy/coolify/Dockerfile',
            description: 'Dockerfile path inside the application repo'
        )
    }

    environment {
        REGISTRY_HOST = 'harbor.dreadwrym.my.id'
        IMAGE_REPO    = 'harbor.dreadwrym.my.id/apps/agentmemory'

        PUBLIC_HOSTNAME = 'agentmemory.dreadwrym.my.id'

        AGENTMEMORY_VERSION = '0.9.30'
        III_VERSION         = '0.22.1'
        III_SDK_VERSION     = '0.22.1'
    }

    stages {
        stage('Build & Push') {
            agent { label 'buildah' }

            stages {
                stage('Checkout') {
                    steps {
                        dir('app') {
                            git url: params.APP_REPO, branch: params.APP_BRANCH, changelog: false, poll: false
                        }

                        script {
                            def appSha = sh(script: 'git -C app rev-parse --short=12 HEAD', returnStdout: true).trim()
                            env.IMAGE = "${env.IMAGE_REPO}:${appSha}-${env.BUILD_NUMBER}"
                        }
                        echo "Building ${env.IMAGE}"
                    }
                }

                stage('Build Image') {
                    steps {
                        container('buildah') {
                            sh '''
                                set -eu

                                REGCONF="$(mktemp)"
                                printf 'unqualified-search-registries = ["docker.io"]\\n' > "$REGCONF"
                                export CONTAINERS_REGISTRIES_CONF="$REGCONF" 

                                buildah build \
                                    --storage-driver=vfs \
                                    --isolation=chroot \
                                    --authfile /auth/.dockerconfigjson \
                                    --build-arg AGENTMEMORY_VERSION="$AGENTMEMORY_VERSION" \
                                    --build-arg III_VERSION="$III_VERSION" \
                                    --build-arg III_SDK_VERSION="$III_SDK_VERSION" \
                                    --file "app/$DOCKERFILE" \
                                    --tag "$IMAGE" \
                                    app
                            '''
                        }
                    }
                }

                stage('Push Image') {
                    steps {
                        container('buildah') {
                            sh '''
                                set -eu

                                buildah --storage-driver=vfs push \
                                    --authfile /auth/.dockerconfigjson \
                                    "$IMAGE" "docker://$IMAGE"
                            '''
                        }
                    }
                }
            }
        }

        stage('Deploy') {
            agent { label 'terraform' }

            when {
                expression { (env.BRANCH_NAME ?: env.GIT_BRANCH) in ['master', 'origin/master'] }
            }

            steps {
                checkout scm

                container('terraform') {
                    dir('apps/agentmemory') {
                        sh '''
                            set -eu

                            terraform init -input=false -lock-timeout=60s \
                              -backend-config="in_cluster_config=true"

                            terraform validate

                            terraform plan -input=false -lock-timeout=60s -out=tfplan \
                              -var="image=${IMAGE}" -var="hostname=${PUBLIC_HOSTNAME}"

                            terraform apply -input=false -lock-timeout=60s -auto-approve tfplan
                        '''
                    }
                }
            }
        }
    }
}
