// Seed job: creates one pipeline job per apps/*/Jenkinsfile in this repo.
// Triggered by SCM polling (configured in infra/jenkins/values.yaml).
pipeline {
    agent { label 'buildah' }

    options {
        disableConcurrentBuilds()
    }

    stages {
        stage('Create app jobs') {
            steps {
                checkout scm

                script {
                    def repoUrl = env.GIT_URL ?: 'https://github.com/Richie-Z/homelab.git'

                    def apps = sh(
                            script: 'ls apps/*/Jenkinsfile 2>/dev/null || true',
                            returnStdout: true
                        ).trim()
                        .readLines()
                        .findAll { it }
                        .collect { it.split('/')[1] }
                        .unique()
                        .sort()

                    if (!apps) {
                        error 'No apps/*/Jenkinsfile found'
                    }

                    def dsl = apps.collect { app ->
                        """
                        pipelineJob('apps/${app}') {
                          description('Generated from apps/${app}/Jenkinsfile')
                          definition {
                            cpsScm {
                              scm {
                                git {
                                  remote { url('${repoUrl}') }
                                  branch('*/main')
                                }
                              }
                              scriptPath('apps/${app}/Jenkinsfile')
                            }
                          }
                          triggers { scm('H/5 * * * *') }
                        }
                        """
                    }.join('\n')

                    writeFile file: 'generated-jobs.groovy', text: dsl
                    jobDsl targets: 'generated-jobs.groovy', removedJobAction: 'IGNORE'

                    echo "Seeded jobs: ${apps.join(', ')}"
                }
            }
        }
    }
}
