// Seed job: creates one pipeline job per apps/*/Jenkinsfile (pipeline 'apps/<name>')
// and per ci/*/Jenkinsfile (pipeline 'ci/<name>'), in this repo.
// Appless runs still refresh this seed job, so no error on an empty matching set.
// Triggered by SCM polling (configured in infra/jenkins/values.yaml).
pipeline {
    agent { label 'buildah' }

    options {
        disableConcurrentBuilds()
    }

    stages {
        stage('Create app jobs') {
            steps {
                checkout scm

                script {
                    def repoUrl = env.GIT_URL ?: 'https://github.com/Richie-Z/homelab.git'
                    def branchName = (env.GIT_BRANCH ?: 'origin/master').replaceFirst('origin/', '')

                    def apps = sh(
                            script: 'ls apps/*/Jenkinsfile 2>/dev/null || true',
                            returnStdout: true
                        ).trim()
                        .readLines()
                        .findAll { it }
                        .collect { it.split('/')[1] }
                        .unique()
                        .sort()

                    def ci = sh(
                            script: 'ls ci/*/Jenkinsfile 2>/dev/null || true',
                            returnStdout: true
                        ).trim()
                        .readLines()
                        .findAll { it }
                        .collect { it.split('/')[1] }
                        .unique()
                        .sort()

                    def dsl = ''

                    if (!apps) {
                        echo 'No apps/*/Jenkinsfile found'
                    } else {
                        dsl = "folder('apps')\n" + apps.collect { app ->
                            """
                            pipelineJob('apps/${app}') {
                              description('Generated from apps/${app}/Jenkinsfile')
                              definition {
                                cpsScm {
                                  scm {
                                    git {
                                      remote { url('${repoUrl}') }
                                      branch('*/${branchName}')
                                    }
                                  }
                                  scriptPath('apps/${app}/Jenkinsfile')
                                }
                              }
                            }
                            """
                        }.join('\n')
                        echo "Seeded jobs: ${apps.join(', ')}"
                    }

                    if (ci) {
                        dsl += "\nfolder('ci')\n" + ci.collect { name ->
                            """
                            pipelineJob('ci/${name}') {
                              description('Generated from ci/${name}/Jenkinsfile')
                              definition {
                                cpsScm {
                                  scm {
                                    git {
                                      remote { url('${repoUrl}') }
                                      branch('*/${branchName}')
                                    }
                                  }
                                  scriptPath('ci/${name}/Jenkinsfile')
                                }
                              }
                            }
                            """
                        }.join('\n')
                        echo "Seeded ci jobs: ${ci.join(', ')}"
                    }

                    writeFile file: 'generated_jobs.groovy', text: dsl
                    jobDsl targets: 'generated_jobs.groovy', removedJobAction: 'IGNORE'
                }
            }
        }
    }
}
