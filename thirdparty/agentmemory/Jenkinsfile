@Library('homelab') _

pipeline {
    agent none

    options {
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 30, unit: 'MINUTES')
    }

    parameters {
        string(
            name: 'APP_REPO',
            defaultValue: 'https://github.com/rohitg00/agentmemory.git',
            description: 'Git URL of the agentmemory application repo'
        )
        string(
            name: 'APP_BRANCH',
            defaultValue: 'main',
            description: 'Branch of the application repo to build'
        )
        string(
            name: 'DOCKERFILE',
            defaultValue: 'deploy/Dockerfile',
            description: 'Dockerfile path inside the application repo'
        )
        booleanParam(
            name: 'FORCE_REBUILD',
            defaultValue: false,
            description: 'Build and push even if the image tag already exists in Harbor'
        )
    }

    environment {
        APP_REPO      = "${params.APP_REPO}"
        APP_BRANCH    = "${params.APP_BRANCH}"
        DOCKERFILE    = "${params.DOCKERFILE}"
        FORCE_REBUILD = "${params.FORCE_REBUILD}"

        REGISTRY_HOST = 'harbor.dreadwrym.my.id'
        IMAGE_REPO    = 'harbor.dreadwrym.my.id/apps/agentmemory'
        CACHE_REPO    = 'harbor.dreadwrym.my.id/apps/agentmemory-cache'
        AUTHFILE      = '/auth/.dockerconfigjson'
    }

    stages {
        agent { label 'buildah' }

        stage('Checkout') {
            steps {
                dir('app') {
                    git url: env.APP_REPO, branch: env.APP_BRANCH, changelog: false, poll: false
                }

                script {
                    def appSha = sh(script: 'git -C app rev-parse --short=12 HEAD', returnStdout: true).trim()
                    env.TAG = appSha
                    env.IMAGE = "${env.IMAGE_REPO}:${appSha}"
                }
            }
        }

        stage('Build image') {
            steps {
                container('buildah') {
                    script{
                        buildImage(
                            dockerFilePath: "app/$DOCKERFILE",
                            context: 'app',
                            imageName: 'agentmemory',
                            tag: env.TAG,
                            forceRebuild: params.FORCE_REBUILD,
                        )
                    }
                }
            }
        }
    }
}
