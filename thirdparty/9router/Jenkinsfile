@Library('homelab') _

pipeline {
    agent { label 'buildah' }

    options {
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 30, unit: 'MINUTES')
    }

    parameters {
        string(
            name: 'APP_REPO',
            defaultValue: 'https://github.com/decolua/9router.git',
            description: 'Git URL of the 9router application repo'
        )
        string(
            name: 'APP_BRANCH',
            defaultValue: 'master',
            description: 'Branch of the application repo to build'
        )
        string(
            name: 'DOCKERFILE',
            defaultValue: 'Dockerfile',
            description: 'Dockerfile path inside the application repo'
        )
        booleanParam(
            name: 'FORCE_REBUILD',
            defaultValue: false,
            description: 'Build and push even if the image tag already exists in Harbor'
        )
    }

    stages {
        stage('Checkout') {
            steps {
                dir('app') {
                    git url: params.APP_REPO, branch: params.APP_BRANCH, changelog: false, poll: false
                }

                script {
                    env.TAG = sh(script: 'git -C app rev-parse --short=12 HEAD', returnStdout: true).trim()
                }
            }
        }

        stage('Build Image & Push') {
            steps {
                container('buildah') {
                    script {
                        buildImage(
                            dockerFilePath: "app/${params.DOCKERFILE}",
                            context: 'app',
                            imageName: '9router',
                            tag: env.TAG,
                            forceRebuild: params.FORCE_REBUILD,
                            buildArgs: [APP_VERSION: 'latest'],
                        )
                    }
                }
            }
        }

        stage('Bump GitOps tag') {
            steps {
                container('buildah') {
                    script {
                        bumpGitopsTag(
                            filePath: 'thirdparty/9router/image.yaml',
                            scope: '9router',
                            tag: env.TAG,
                            credentialsId: 'gh-homelab',
                        )
                    }
                }
            }
        }
    }
}
